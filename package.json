{
  "name": "lowroute",
  "private": true,
  "version": "0.1.0",
  "description": "Lowroute MVP flight deals bot scaffold",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false --noEmit",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\" \"**/*.mdc\" \"**/*.plan.md\" \"!**/node_modules/**\" \"!**/dist/**\"",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "migrate:up": "node-pg-migrate up -m infra/migrations",
    "migrate:down": "node-pg-migrate down -m infra/migrations",
    "smoke:provider": "tsx scripts/run-provider-smoke.ts",
    "refresh:fixtures": "tsx scripts/refresh-provider-fixtures.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.15.18",
    "@types/pg": "8.15.2",
    "markdownlint-cli2": "0.18.1",
    "node-pg-migrate": "8.0.3",
    "pg-boss": "10.4.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
