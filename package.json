{
  "name": "lowroute",
  "private": true,
  "version": "0.1.0",
  "description": "Lowroute | A simple flight deals bot",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false --noEmit",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\" \"**/*.mdc\" \"**/*.plan.md\" \"!**/node_modules/**\" \"!**/dist/**\"",
    "format": "biome format --write .",
    "prepare": "lefthook install",
    "hooks:install": "lefthook install",
    "test": "pnpm -r test",
    "precommit": "tsx scripts/precommit.ts",
    "precommit:fast": "tsx scripts/precommit.ts --fast",
    "migrate:up": "node-pg-migrate up -m infra/migrations",
    "migrate:down": "node-pg-migrate down -m infra/migrations",
    "smoke:provider": "tsx scripts/run-provider-smoke.ts",
    "refresh:fixtures": "tsx scripts/refresh-provider-fixtures.ts",
    "benchmark:gate": "tsx scripts/validate-recent-deals-benchmark.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "lefthook": "^2.1.6",
    "markdownlint-cli2": "0.23.2",
    "node-pg-migrate": "9.0.0",
    "pg-boss": "12.27.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
